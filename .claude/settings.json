{
  "permissions": {
    "allow": [
      "Bash(scripts/verify)",
      "Bash(scripts/verify *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/verify-on-stop.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}

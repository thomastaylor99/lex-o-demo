# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[oc]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
.next/
*.tsbuildinfo

# Claude Code, machine-specific
.claude/settings.local.json
.claude/worktrees/
.claude/.verify-pass

# Visitor audio and images never enter git
*.wav
*.webm
*.mp3
*.m4a
# Synthetic test voices made with the TTS are fixtures, not visitor audio
!backend/tests/fixtures/audio/*.wav
!frontend/tests/fixtures/audio/*.wav

# macOS
.DS_Store

# Spike raw measurements stay local; READMEs and scripts are the record
spikes/*/results/
spikes/*/latency_results.json
